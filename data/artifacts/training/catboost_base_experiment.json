{
  "model": "catboost_base",
  "family": "catboost",
  "feature_set": "base",
  "features": [
    "warehouse_name",
    "article",
    "category_lvl_1",
    "category_lvl_2",
    "characteristic"
  ],
  "parameters": {
    "iterations": 250,
    "depth": 6,
    "learning_rate": 0.08,
    "loss_function": "MAE",
    "eval_metric": "MAE",
    "random_seed": 42,
    "thread_count": 8,
    "l2_leaf_reg": 5,
    "bootstrap_type": "Bernoulli",
    "subsample": 0.8,
    "max_ctr_complexity": 1,
    "one_hot_max_size": 20,
    "allow_writing_files": false
  },
  "seed": 42,
  "train_rows": 600000,
  "train_end": "2026-06-05",
  "valid_start": "2026-06-06",
  "test_start": "2026-07-04"
}