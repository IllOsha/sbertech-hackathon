    "weight_decay": 0.0001,
    "hidden_widths": [
      64,
      32
    ],
    "target_transform": "log1p",
    "loss": "MSE(log1p quantity)",
    "cross_layers": 0
  },
  "seed": 42,
  "train_rows": 600000,
  "train_end": "2026-06-05",
  "valid_start": "2026-06-06",
  "test_start": "2026-07-04"
}